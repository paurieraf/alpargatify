<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>WFWorkflowActions</key>
    <array>
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.runshellscript</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>65A56AB1-C580-4EDB-B07D-C87591A6019D</string>
                <key>Shell</key>
                <string>/bin/zsh</string>
                <key>InputMode</key>
                <string>Arguments</string>
                <key>Input</key>
                <dict>
                    <key>Value</key>
                    <dict>
                        <key>Type</key>
                        <string>ExtensionInput</string>
                    </dict>
                    <key>WFSerializationType</key>
                    <string>WFTextTokenAttachment</string>
                </dict>
                <key>Script</key>
                <string>SCRIPT="$HOME/dev/workspace/alpargatify/library-organizer/flac-to-lossy.sh"
BASEDEST="/tmp/lossy-temp"

# Accept input either as arguments or via stdin (one path per line)
args=("$@")
if [ ${#args[@]} -eq 0 ]; then
  while IFS= read -r line; do [ -n "$line" ] &amp;&amp; args+=("$line"); done
fi

if [ ${#args[@]} -eq 0 ]; then
  echo "No input folder received" &gt;&amp;2
  exit 1
fi

launcher="/tmp/conversor-temporal-$$.command"
{
  echo '#!/bin/zsh'
  echo 'echo "=== Conversor temporal (flac-to-lossy) ==="'
  for SRC in "${args[@]}"; do
    SRC="${SRC%/}"
    DEST="$BASEDEST/$(basename "$SRC")"
    printf 'echo "\n&gt;&gt;&gt; %q"\n' "$SRC"
    printf '%q %q %q\n' "$SCRIPT" "$SRC" "$DEST"
  done
  echo 'echo "\n=== ALL DONE ==="'
  echo 'read "?Press Return to close..."'
} &gt; "$launcher"
chmod +x "$launcher"
open "$launcher"</string>
            </dict>
        </dict>
    </array>
    <key>WFWorkflowClientVersion</key>
    <string>2700.0.4</string>
    <key>WFWorkflowHasOutputFallback</key>
    <false/>
    <key>WFWorkflowHasShortcutInputVariables</key>
    <true/>
    <key>WFWorkflowIcon</key>
    <dict>
        <key>WFWorkflowIconGlyphNumber</key>
        <integer>59495</integer>
        <key>WFWorkflowIconStartColor</key>
        <integer>4292093695</integer>
    </dict>
    <key>WFWorkflowImportQuestions</key>
    <array/>
    <key>WFWorkflowInputContentItemClasses</key>
    <array>
        <string>WFFolderContentItem</string>
        <string>WFGenericFileContentItem</string>
    </array>
    <key>WFWorkflowMinimumClientVersion</key>
    <integer>900</integer>
    <key>WFWorkflowMinimumClientVersionString</key>
    <string>900</string>
    <key>WFWorkflowName</key>
    <string>Conversor temporal</string>
    <key>WFWorkflowOutputContentItemClasses</key>
    <array/>
    <key>WFWorkflowTypes</key>
    <array>
        <string>ActionExtension</string>
    </array>
</dict>
</plist>
